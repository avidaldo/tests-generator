{
  "chat.promptFilesLocations": {
    "prompts": true,
    ".github/prompts": true
  },
  "[markdown]": {
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 120,
    "editor.quickSuggestions": {
